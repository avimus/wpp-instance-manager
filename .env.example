# App
NEXT_PUBLIC_APP_URL=https://<seu-dominio>.vercel.app   # http://localhost:3000 em dev

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# WPP Connect Service (Cloud Run)
WPP_SERVICE_URL=http://localhost:3001
WPP_SERVICE_SECRET=<shared-secret-min-32-chars>
WPP_WEBHOOK_SECRET=<webhook-hmac-secret-min-32-chars>

# Notifications — Email (Resend)
RESEND_API_KEY=re_<resend-api-key>
ALERT_FROM_EMAIL=alertas@seudominio.com

# Notifications — WhatsApp (instância de sistema)
WPP_SYSTEM_SESSION_ID=sistema-alertas

# Session encryption (pgcrypto)
SESSION_ENCRYPTION_KEY=<base64-32-bytes-random>

# Internal (set automatically by Cloud Run in production)
NEXTJS_WEBHOOK_URL=https://<app>.vercel.app/api/webhooks/wpp
